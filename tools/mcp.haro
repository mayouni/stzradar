# The radar for agents: a small, read-only MCP server over the signed feed.
#
#   haro tools/mcp.haro            run from the repository root; speaks MCP over standard input and output
#   haro tools/mcp.haro <folder>   the same, for the radar checked out in <folder>
#
# An agent that supports MCP (Claude Code, an IDE, any MCP client) starts this program and asks it
# questions while it works: what this week asks of a developer, which signals touch a part of the
# project, one signal in full. Everything comes from the radar's own files -- feed/index.json, the map,
# app/config.json -- and nothing is answered until feed/index.json's signature checks against
# keys/allowed_signers (ssh-keygen does the cryptography, as tools/feed.haro verify does).
#
# The protocol: JSON-RPC 2.0, one message per line (MCP's stdio transport). It answers initialize,
# ping, tools/list and tools/call, and ignores notifications. Nothing it does writes a file.

load "feedlib.haro"

tRoot = ""
xCfg = ""
xMap = ""
xItems = []
xDigests = []
tTrust = ""            # "" when the signature checked; otherwise why it did not

func main
    $tRoot = CurrentDir()
    if Len(sysargv) >= 3 $tRoot = sysargv[3] end
    LoadRadar()
    nEmpty = 0
    while true
        give tLine
        if tLine = ""
            nEmpty++
            if nEmpty > 3 exit end          # the client closed our input
            loop
        end
        nEmpty = 0
        Handle(tLine)
    end
end
# ---------------------------------------------------------------- the radar's data

func LoadRadar
    oReader = new JsonReader
    try
        xIndex = oReader.Parse(Read($tRoot + "/feed/index.json"), "feed/index.json")
        $xItems = JItems(JGet(xIndex, "items"))
        $xCfg = oReader.Parse(Read($tRoot + "/app/config.json"), "app/config.json")
    catch e
        $tTrust = "the radar's files could not be read from " + $tRoot + ": " + e.Message()
        return
    end
    try
        $xMap = oReader.Parse(Read($tRoot + "/" + Cf("map")), "map")
    catch
        $tTrust = "the map " + Cf("map") + " could not be read"
        return
    end
    if FExists($tRoot + "/app/digests.json")
        try
            $xDigests = JItems(oReader.Parse(Read($tRoot + "/app/digests.json"), "digests"))
        catch
            $xDigests = []
        end
    end
    $tTrust = CheckSignature()
end
# The feed is trusted only when its signature checks; ssh-keygen's own words are kept off our output,
# which carries the protocol.
func CheckSignature
    tIdx = $tRoot + "/feed/index.json"
    if not FExists(tIdx + ".sig") return "feed/index.json has no signature (feed/index.json.sig)" end
    if not FExists($tRoot + "/keys/allowed_signers") return "there is no key to check the feed against (keys/allowed_signers)" end
    tQuiet = " >/dev/null 2>&1"
    if IsWindows() tQuiet = " >nul 2>&1" end
    tCmd = "ssh-keygen -Y verify -f " + Q($tRoot + "/keys/allowed_signers") + " -I " + Cf("feed.signer") +
           " -n " + Cf("feed.namespace") + " -s " + Q(tIdx + ".sig") + " < " + Q(tIdx) + tQuiet
    if System(tCmd) != 0 return "feed/index.json's signature does not check against keys/allowed_signers (or ssh-keygen is missing)" end
    return ""
end
func Q(tC)
    return '"' + tC + '"'
end
# one value of app/config.json by its dotted path
func Cf(tPath)
    xV = $xCfg
    tPart = ""
    tP = tPath + "."
    nP = Len(tP)
    for i = 1 to nP
        if tP[i] = "."
            if JKind(xV) != "object" or not JHas(xV, tPart) return "" end
            xV = JGet(xV, tPart)
            tPart = ""
        else
            tPart += tP[i]
        end
    end
    if IsString(xV) return xV end
    return ""
end
func S(xO, tKey)
    if JKind(xO) != "object" return "" end
    xV = JGet(xO, tKey)
    if IsString(xV) return xV end
    return ""
end
func Word(tLevel)
    if tLevel = "info" return "To know" end
    if tLevel = "advice" return "To consider" end
    if tLevel = "action" return "To do" end
    if tLevel = "urgent" return "To do now" end
    return tLevel
end
func LevelRank(tLevel)
    return Find(["info", "advice", "action", "urgent"], tLevel)
end
func RelRank(tC)
    return Find(["low", "medium", "high"], tC)
end
# ISO week of a "YYYY-MM-DD" date, as "YYYY-Www"
func IsoWeek(tDate)
    nY = Number(Left(tDate, 4)) nMo = Number(SubStr(tDate, 6, 2)) nDa = Number(SubStr(tDate, 9, 2))
    xCum = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    nOrd = xCum[nMo] + nDa
    if nMo > 2 and Leap(nY) nOrd++ end
    nW = Floor((nOrd - Dow(nY, nMo, nDa) + 10) / 7)
    if nW < 1
        nY--
        nW = WeeksIn(nY)
    elseif nW > WeeksIn(nY)
        nY++
        nW = 1
    end
    tW = "" + String(nW)
    if nW < 10 tW = "0" + tW end
    return "" + String(nY) + "-W" + tW
end
func Leap(xY)
    return (xY % 4 = 0 and xY % 100 != 0) or xY % 400 = 0
end
# Monday 1 .. Sunday 7
func Dow(xY, nM, xD)
    vT = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    if nM < 3 xY-- end
    xN = (xY + Floor(xY / 4) - Floor(xY / 100) + Floor(xY / 400) + vT[nM] + xD) % 7
    if xN = 0 return 7 end
    return xN
end
func WeeksIn(xY)
    if P(xY) = 4 or P(xY - 1) = 3 return 53 end
    return 52
end
func P(xY)
    return (xY + Floor(xY / 4) - Floor(xY / 100) + Floor(xY / 400)) % 7
end
# the project ids an entry touches: its areas through the map's ids and aliases
func ProjectsOf(xO)
    xOut = []
    xA = JGet(xO, "areas")
    if JKind(xA) != "array" return xOut end
    xAs = JItems(xA)
    xPs = JItems(JGet($xMap, "projects"))
    nA = Len(xAs) nP = Len(xPs)
    for i = 1 to nA
        tA = Lower(xAs[i])
        tHead = tA
        nDot = SubStr(tA, ".")
        if nDot > 0 tHead = Left(tA, nDot - 1) end
        tHit = ""
        for k = 1 to nP
            tId = S(xPs[k], "id")
            if tA = tId or tHead = tId tHit = tId exit end
            xAl = JGet(xPs[k], "aliases")
            if JKind(xAl) = "array"
                xAls = JItems(xAl) nAl = Len(xAls)
                for j = 1 to nAl
                    if Lower(xAls[j]) = tA or Lower(xAls[j]) = tHead tHit = tId exit 2 end
                end
            end
        end
        if tHit != "" and Find(xOut, tHit) = 0 xOut + tHit end
    end
    return xOut
end
func LayersOf(xO)
    xOut = []
    xPr = ProjectsOf(xO)
    xPs = JItems(JGet($xMap, "projects"))
    nN = Len(xPr) nP = Len(xPs)
    for i = 1 to nN
        for k = 1 to nP
            if S(xPs[k], "id") = xPr[i]
                tL = S(xPs[k], "layer")
                if Find(xOut, tL) = 0 xOut + tL end
            end
        end
    end
    return xOut
end
func NameOf(tList, tId)
    xX = JItems(JGet($xMap, tList))
    nN = Len(xX)
    for i = 1 to nN
        if S(xX[i], "id") = tId return S(xX[i], "name") end
    end
    return tId
end
func HasIn(xO, tKey, tId)
    xV = JGet(xO, tKey)
    if JKind(xV) != "array" return false end
    return Find(JItems(xV), tId) > 0
end
# newest week the survey closed (it has a digest), else the newest week that holds an entry
func LatestWeek
    tBest = ""
    nN = Len($xDigests)
    for i = 1 to nN
        if IsString($xDigests[i]) and $xDigests[i] > tBest tBest = $xDigests[i] end
    end
    if tBest != "" return tBest end
    nN = Len($xItems)
    for i = 1 to nN
        xW = IsoWeek(S($xItems[i], "date"))
        if xW > tBest tBest = xW end
    end
    return tBest
end
# most pressing first: level, then relevance, then newest
func SortItems(xIn)
    xAs = xIn
    nN = Len(xAs)
    for i = 2 to nN
        xJ = i
        while xJ > 1 and Before(xAs[xJ], xAs[xJ - 1])
            xT = xAs[xJ] xAs[xJ] = xAs[xJ - 1] xAs[xJ - 1] = xT
            xJ--
        end
    end
    return xAs
end
func Before(xA, xB)
    xLa = LevelRank(S(xA, "level")) xLb = LevelRank(S(xB, "level"))
    if xLa != xLb return xLa > xLb end
    xRa = RelRank(S(xA, "relevance")) xRb = RelRank(S(xB, "relevance"))
    if xRa != xRb return xRa > xRb end
    return S(xA, "date") > S(xB, "date")
end
func ReaderOk(tC)
    return Find(["developer", "maintainer", "learner", "user"], tC) > 0
end
# one signal in a few lines, for a list
func Brief(xO, tReader, nNo)
    tC = "" + String(nNo) + ". [" + Word(S(xO, "level")) + "] " + S(xO, "title") + Char(10)
    tLine = ""
    xN = JGet(xO, "notice")
    if JKind(xN) = "object" tLine = S(xN, tReader) end
    if tLine = "" tLine = S(xO, "summary") end
    tC += "   " + tLine + Char(10)
    xPr = ProjectsOf(xO)
    xNames = []
    nN = Len(xPr)
    for i = 1 to nN xNames + NameOf("projects", xPr[i]) end
    tC += "   touches: " + Joined(xNames, ", ") + " | id: " + S(xO, "id") + " | " + S(xO, "date") + Char(10)
    return tC
end
func Joined(xA, tSep)
    tC = ""
    nN = Len(xA)
    for i = 1 to nN
        if i > 1 tC += tSep end
        tC += xA[i]
    end
    return tC
end
# ---------------------------------------------------------------- the tools

func ToolList
    tR = '"reader":{"type":"string","enum":["developer","maintainer","learner","user"],"description":"who the answer is written for; default developer"}'
    return '{"tools":[' +
      '{"name":"radar_week","description":"The signals of one week, most pressing first, each with the sentence written for the reader. Without a week, the latest surveyed week.",' +
      '"inputSchema":{"type":"object","properties":{"week":{"type":"string","description":"ISO week, e.g. 2026-W45"},' + tR + '}}},' +
      '{"name":"radar_search","description":"Signals that match every filter given: a project, layer, domain or concern of the map (ids from radar_map), a lowest level, a week, or words in the title or summary.",' +
      '"inputSchema":{"type":"object","properties":{"project":{"type":"string"},"layer":{"type":"string"},"domain":{"type":"string"},"concern":{"type":"string"},' +
      '"level_at_least":{"type":"string","enum":["info","advice","action","urgent"]},"week":{"type":"string"},"text":{"type":"string"},' + tR + '}}},' +
      '{"name":"radar_signal","description":"One signal in full: what happened, the sentence for each reader, what was proposed, its sources and its page.",' +
      '"inputSchema":{"type":"object","properties":{"id":{"type":"string","description":"the signal id, from radar_week or radar_search"}},"required":["id"]}},' +
      '{"name":"radar_map","description":"The project map signals are placed on: layers, parts (projects), domains and concerns, with the ids the other tools take.",' +
      '"inputSchema":{"type":"object","properties":{}}}' +
      ']}'
end
func Arg(xArgs, tKey)
    if JKind(xArgs) != "object" return "" end
    return S(xArgs, tKey)
end
func CallTool(tName, xArgs)
    if $tTrust != "" return [true, "The radar did not answer: " + $tTrust + ". Its feed is trusted only when its signature checks."] end
    tReader = Lower(Arg(xArgs, "reader"))
    if not ReaderOk(tReader) tReader = "developer" end
    if tName = "radar_week" return [false, ToolWeek(Arg(xArgs, "week"), tReader)] end
    if tName = "radar_search" return [false, ToolSearch(xArgs, tReader)] end
    if tName = "radar_signal" return ToolSignal(Arg(xArgs, "id")) end
    if tName = "radar_map" return [false, ToolMap()] end
    return [true, "There is no tool named " + tName + "; the tools are radar_week, radar_search, radar_signal and radar_map."]
end
func ToolWeek(tWeek, tReader)
    if tWeek = "" tWeek = LatestWeek() end
    xWs = []
    nN = Len($xItems)
    for i = 1 to nN
        xO = $xItems[i]
        if IsoWeek(S(xO, "date")) = tWeek and S(xO, "status") != "superseded" xWs + xO end
    end
    if Len(xWs) = 0 return Cf("watch.title") + " holds no signal for week " + tWeek + "." end
    xWs = SortItems(xWs)
    tN = "" + String(Len(xWs)) + " signals"
    if Len(xWs) = 1 tN = "1 signal" end
    tC = Cf("watch.title") + ", week " + tWeek + ": " + tN + ", written for a " + tReader + "." + Char(10) + Char(10)
    nN = Len(xWs)
    for i = 1 to nN tC += Brief(xWs[i], tReader, i) end
    tC += Char(10) + "Ask radar_signal with an id for the whole signal."
    return tC
end
func ToolSearch(xArgs, tReader)
    tP = Lower(Arg(xArgs, "project")) tL = Lower(Arg(xArgs, "layer")) tD = Lower(Arg(xArgs, "domain"))
    tC = Lower(Arg(xArgs, "concern")) tV = Lower(Arg(xArgs, "level_at_least")) tW = Arg(xArgs, "week")
    tT = Lower(Arg(xArgs, "text"))
    xHit = []
    nN = Len($xItems)
    for i = 1 to nN
        xO = $xItems[i]
        if S(xO, "status") = "superseded" loop end
        if tP != "" and Find(ProjectsOf(xO), tP) = 0 loop end
        if tL != "" and Find(LayersOf(xO), tL) = 0 loop end
        if tD != "" and not HasIn(xO, "domains", tD) loop end
        if tC != "" and not HasIn(xO, "concerns", tC) loop end
        if tV != "" and LevelRank(S(xO, "level")) < LevelRank(tV) loop end
        if tW != "" and IsoWeek(S(xO, "date")) != tW loop end
        if tT != "" and SubStr(Lower(S(xO, "title") + " " + S(xO, "summary")), tT) = 0 loop end
        xHit + xO
    end
    if Len(xHit) = 0 return "No signal matches these filters. radar_map lists the ids the filters take." end
    xHit = SortItems(xHit)
    tN = "" + String(Len(xHit)) + " signals match"
    if Len(xHit) = 1 tN = "1 signal matches" end
    xC = tN + ", most pressing first, written for a " + tReader + "." + Char(10) + Char(10)
    nN = Len(xHit)
    for i = 1 to nN xC += Brief(xHit[i], tReader, i) end
    return xC
end
func ToolSignal(tId)
    nN = Len($xItems)
    for i = 1 to nN
        xO = $xItems[i]
        if S(xO, "id") = tId
            tNL = Char(10)
            tC = S(xO, "title") + tNL + tNL
            tC += "Level: " + Word(S(xO, "level")) + ". Kind: " + S(xO, "kind") + ". Stance: " + S(xO, "stance") + ". Relevance: " +
                 S(xO, "relevance") + ". Date: " + S(xO, "date") + ". Week: " + IsoWeek(S(xO, "date")) + "." + tNL + tNL
            tC += "What happened: " + S(xO, "summary") + tNL
            xN = JGet(xO, "notice")
            if JKind(xN) = "object"
                tC += tNL + "For each reader:" + tNL
                xPs = xN[2] nP = Len(xPs)
                for k = 1 to nP
                    if IsString(xPs[k][2]) tC += "- " + xPs[k][1] + ": " + xPs[k][2] + tNL end
                end
            end
            xA = JGet(xO, "actions")
            if JKind(xA) = "array" and Len(JItems(xA)) > 0
                tC += tNL + "Proposed:" + tNL
                xAs = JItems(xA) nA = Len(xAs)
                for k = 1 to nA tC += "- " + S(xAs[k], "area") + ": " + S(xAs[k], "do") + " (" + S(xAs[k], "state") + ")" + tNL end
            end
            xS = JGet(xO, "sources")
            if JKind(xS) = "array"
                tC += tNL + "Sources:" + tNL
                xSs = JItems(xS) nS = Len(xSs)
                for k = 1 to nS tC += "- " + S(xSs[k], "title") + ": " + S(xSs[k], "url") + tNL end
            end
            tC += tNL + "Page: " + Cf("watch.pages") + "items/" + Left(tId, 4) + "/" + tId + ".md"
            return [false, tC]
        end
    end
    return [true, "There is no signal " + tId + "; radar_week and radar_search give the ids."]
end
func ToolMap
    tNL = Char(10)
    tC = "The map of " + Cf("project.name") + " (id: name)." + tNL
    xLists = [["layers", "Layers"], ["projects", "Parts"], ["domains", "Domains"], ["concerns", "Concerns"]]
    for q = 1 to 4
        xList = xLists[q]
        tC += tNL + xList[2] + ":" + tNL
        xX = JItems(JGet($xMap, xList[1]))
        nN = Len(xX)
        for i = 1 to nN
            tC += "- " + S(xX[i], "id") + ": " + S(xX[i], "name")
            if xList[1] = "projects" tC += " (layer " + S(xX[i], "layer") + ")" end
            tC += tNL
        end
    end
    return tC
end
# ---------------------------------------------------------------- the protocol

func Handle(tLine)
    oReader = new JsonReader
    try
        xMsg = oReader.Parse(tLine, "message")
    catch
        Send('{"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"Parse error"}}')
        return
    end
    if JKind(xMsg) != "object" return end
    if not JHas(xMsg, "id") return end                       # a notification: nothing to answer
    tId = JLine(JGet(xMsg, "id"))
    tMethod = S(xMsg, "method")
    xParams = JGet(xMsg, "params")
    if tMethod = "initialize"
        tVer = S(xParams, "protocolVersion")
        if tVer = "" tVer = "2025-06-18" end
        Result(tId, '{"protocolVersion":' + JQuote(tVer) + ',"capabilities":{"tools":{}},' +
            '"serverInfo":{"name":"softanza-radar","title":' + JQuote(Cf("watch.title")) + ',"version":"1.0.0"},' +
            '"instructions":' + JQuote(Cf("watch.title") + ": " + Cf("watch.tagline") + ". Start with radar_week; use radar_map for the ids radar_search takes.") + '}')
        return
    end
    if tMethod = "ping" Result(tId, "{}") return end
    if tMethod = "tools/list" Result(tId, ToolList()) return end
    if tMethod = "tools/call"
        xArgs = ["n"]
        if JKind(xParams) = "object" xArgs = JGet(xParams, "arguments") end
        xR = CallTool(S(xParams, "name"), xArgs)
        tErr = "false"
        if xR[1] tErr = "true" end
        Result(tId, '{"content":[{"type":"text","text":' + JQuote(xR[2]) + '}],"isError":' + tErr + '}')
        return
    end
    Send('{"jsonrpc":"2.0","id":' + tId + ',"error":{"code":-32601,"message":' + JQuote("Method not found: " + tMethod) + '}}')
end
func Result(tId, tJson)
    Send('{"jsonrpc":"2.0","id":' + tId + ',"result":' + tJson + '}')
end
func Send(tC)
    FWrite(stdout, tC + Char(10))
    Flush()
end
# Haro buffers a program's output when it goes to a pipe, and has no flush for it yet; system() flushes
# it before running its command, so an empty command sends each reply now. The client waits on every reply,
# so without this nothing would arrive until the program ended. Reported to the Haro desk (HARO-STDIOFLUSH-01):
# give should flush before it waits for input, as C's stdio does, or Haro should offer flush().
func Flush
    if IsWindows() System("rem") else System(":") end
end
# a JSON value on one line (the stdio transport carries one message per line)
func JLine(xV)
    xK = JKind(xV)
    if xK = "string" return JQuote(xV) end
    if xK = "number" return xV[2] end
    if xK = "boolean"
        if xV[1] = "t" return "true" end
        return "false"
    end
    if xK = "null" return "null" end
    tC = ""
    xI = xV[2]
    nN = Len(xI)
    for i = 1 to nN
        if i > 1 tC += "," end
        if xK = "array" tC += JLine(xI[i]) else tC += JQuote(xI[i][1]) + ":" + JLine(xI[i][2]) end
    end
    if xK = "array" return "[" + tC + "]" end
    return "{" + tC + "}"
end
