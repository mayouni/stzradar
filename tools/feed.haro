# Radar's feed generator and its check.
#
#   haro tools/feed.haro           check every entry, then regenerate feed/index.json and feed/feed.json
#   haro tools/feed.haro check     check every entry and both committed feeds; write nothing
#   haro tools/feed.haro verify    check that both feed files carry a good signature (docs/FEED.md, "The signature")
#
# Run it from the repository root. The exit code is the number of problems found, so 0 means
# every entry passed, both feeds match their schema, and (in check mode) the committed feeds are
# exactly what the entries generate. The rules are docs/FEED.md; the shapes are schema/.
#
# It runs on Haro. The work is in tools/feedlib.haro, which needs no
# other library; tools/guard.haro proves that the check refuses broken entries.

load "feedlib.haro"

func main
    nStart = Clock()
    tMode = "generate"
    if Len(sysargv) >= 3
        tMode = Lower(sysargv[3])
    end
    if tMode != "generate" and tMode != "check" and tMode != "verify"
        FWrite(stdout, "usage: haro tools/feed.haro [check | verify]" + Char(10))
        Shutdown(1)
    end
    if tMode = "verify"
        oConf = new FeedRun
        oConf.tRoot = CurrentDir()
        if not oConf.Prepare() Shutdown(1) end
        Shutdown(Verify(oConf.Conf("feed.signer"), oConf.Conf("feed.namespace")))
    end

    oRun = new FeedRun
    oRun.tRoot = CurrentDir()
    oRun.Go(tMode)

    nMs = Floor((Clock() - nStart) * 1000 / ClocksPerSecond())
    FWrite(stdout, "entries accepted " + String(oRun.nEntries) + ", problems " + String(Len(oRun.xProblems)) + ", " + String(nMs) + " ms" + Char(10))
    Shutdown(Len(oRun.xProblems))
end

# Both feed files must carry a good SSH signature by the key in keys/allowed_signers, for the
# signer and namespace radar.yaml names (feed.signer, feed.namespace). ssh-keygen does the
# cryptography; this only asks it, file by file, and counts what it refuses. Returns the number of problems.
func Verify(tSigner, tNamespace)
    xFiles = ["feed/index.json", "feed/feed.json"]
    nBad = 0
    if not FExists("keys/allowed_signers")
        FWrite(stdout, "REFUSED keys/allowed_signers: there is no key to check against" + Char(10))
        return 1
    end
    nF = Len(xFiles)
    for i = 1 to nF
        tF = xFiles[i]
        if not FExists(tF + ".sig")
            FWrite(stdout, "REFUSED " + tF + ": it has no signature, " + tF + ".sig" + Char(10))
            nBad++
            loop
        end
        tCmd = "ssh-keygen -Y verify -f keys/allowed_signers -I " + tSigner + " -n " + tNamespace + " -s " +
               tF + ".sig < " + tF
        if System(tCmd) != 0
            FWrite(stdout, "REFUSED " + tF + ": its signature does not verify; sign it again after any change" + Char(10))
            nBad++
        end
    end
    FWrite(stdout, "signatures checked " + String(nF) + ", problems " + String(nBad) + Char(10))
    return nBad
end
