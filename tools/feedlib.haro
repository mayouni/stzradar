# Radar's feed library: the JSON reader and writer, the schema check, and the run that
# turns items/ into feed/index.json and feed/feed.json. tools/feed.haro is its command and
# tools/guard.haro its guard; both load this file. The rules are docs/FEED.md.
#
# It runs on Haro and needs no other library.

# ---------------------------------------------------------------- JSON values
#
# A string is a Haro string. Everything else is a list whose first item says what it is:
#   ["{", [[key, value], ...]]   an object, keys in the order they were written
#   ["[", [value, ...]]          an array
#   ["#", "12.5"]                a number, kept as the text it was written as
#   ["t"] ["f"] ["n"]            true, false, null

func JKind(xV)
    if IsString(xV) return "string" end
    xT = xV[1]
    if xT = "{" return "object" end
    if xT = "[" return "array" end
    if xT = "#" return "number" end
    if xT = "t" or xT = "f" return "boolean" end
    return "null"
end
func JHas(xObj, tKey)
    xPs = xObj[2]
    nN = Len(xPs)
    for i = 1 to nN
        if xPs[i][1] = tKey return true end
    end
    return false
end
func JGet(xObj, tKey)
    xPs = xObj[2]
    nN = Len(xPs)
    for i = 1 to nN
        if xPs[i][1] = tKey return xPs[i][2] end
    end
    return ["n"]
end
func JKeys(xObj)
    xKs = []
    xPs = xObj[2]
    nN = Len(xPs)
    for i = 1 to nN
        xKs + xPs[i][1]
    end
    return xKs
end
func JItems(xArr)
    return xArr[2]
end
func JEqual(xA, xB)
    xKa = JKind(xA)
    if xKa != JKind(xB) return false end
    if xKa = "string" return xA = xB end
    if xKa = "number" return Number(xA[2]) = Number(xB[2]) end
    if xKa = "boolean" return xA[1] = xB[1] end
    if xKa = "null" return true end
    if xKa = "array"
        nNa = Len(xA[2])
        if nNa != Len(xB[2]) return false end
        for i = 1 to nNa
            if not JEqual(xA[2][i], xB[2][i]) return false end
        end
        return true
    end
    # objects: the same keys with equal values, in any order
    if Len(xA[2]) != Len(xB[2]) return false end
    nNa = Len(xA[2])
    for i = 1 to nNa
        tK = xA[2][i][1]
        if not JHas(xB, tK) return false end
        if not JEqual(xA[2][i][2], JGet(xB, tK)) return false end
    end
    return true
end
func JIsString(xV)
    return IsString(xV)
end
# ---------------------------------------------------------------- JSON writer
#
# The bytes docs/FEED.md fixes: two-space indentation, ": " after a key, "," at the end of a
# line, an empty array or object as [] or {}, non-ASCII text written as UTF-8 and not escaped.

func JWrite(xV, nDepth)
    xK = JKind(xV)
    if xK = "string" return JQuote(xV) end
    if xK = "number" return xV[2] end
    if xK = "boolean"
        if xV[1] = "t" return "true" end
        return "false"
    end
    if xK = "null" return "null" end
    xI = xV[2]
    nN = Len(xI)
    if xK = "array"
        if nN = 0 return "[]" end
        tOpen = "[" tClose = "]"
    else
        if nN = 0 return "{}" end
        tOpen = "{" tClose = "}"
    end
    tPad = Copy(" ", 2 * (nDepth + 1))
    tOut = tOpen + Char(10)
    for i = 1 to nN
        if xK = "array"
            tOut += tPad + JWrite(xI[i], nDepth + 1)
        else
            tOut += tPad + JQuote(xI[i][1]) + ": " + JWrite(xI[i][2], nDepth + 1)
        end
        if i < nN tOut += "," end
        tOut += Char(10)
    end
    tOut += Copy(" ", 2 * nDepth) + tClose
    return tOut
end
func JQuote(xS)
    tOut = '"'
    nN = Len(xS)
    for i = 1 to nN
        xC = xS[i]
        nB = Ascii(xC)
        if xC = '"'
            tOut += "\" + '"'
        elseif xC = "\"
            tOut += "\\"
        elseif nB = 10
            tOut += "\n"
        elseif nB = 13
            tOut += "\r"
        elseif nB = 9
            tOut += "\t"
        elseif nB = 8
            tOut += "\b"
        elseif nB = 12
            tOut += "\f"
        elseif nB < 32
            tOut += "\u00" + Hex2(nB)
        else
            tOut += xC
        end
    end
    return tOut + '"'
end
func Hex2(nN)
    tH = Lower(Hex(nN))
    if Len(tH) < 2 tH = "0" + tH end
    return tH
end
# ---------------------------------------------------------------- small helpers

func Utf8(nN)
    if nN < 128 return Char(nN) end
    if nN < 2048
        return Char(192 + Floor(nN / 64)) + Char(128 + (nN % 64))
    end
    if nN < 65536
        return Char(224 + Floor(nN / 4096)) + Char(128 + (Floor(nN / 64) % 64)) + Char(128 + (nN % 64))
    end
    return Char(240 + Floor(nN / 262144)) + Char(128 + (Floor(nN / 4096) % 64)) +
           Char(128 + (Floor(nN / 64) % 64)) + Char(128 + (nN % 64))
end
# The number of code points in a UTF-8 string: every byte that does not continue a character.
func CodePoints(xS)
    nN = Len(xS)
    nCount = 0
    for i = 1 to nN
        nB = Ascii(xS[i])
        if nB < 128 or nB >= 192 nCount++ end
    end
    return nCount
end
func IsDigits(xS)
    nN = Len(xS)
    if nN = 0 return false end
    for i = 1 to nN
        if not IsDigit(xS[i]) return false end
    end
    return true
end
func IsLeapYear(xY)
    if xY % 400 = 0 return true end
    if xY % 100 = 0 return false end
    if xY % 4 = 0 return true end
    return false
end
# YYYY-MM-DD, and a day that exists.
func IsDate(xS)
    if Len(xS) != 10 return false end
    if xS[5] != "-" or xS[8] != "-" return false end
    tY = SubStr(xS, 1, 4) tM = SubStr(xS, 6, 2) tD = SubStr(xS, 9, 2)
    if not (IsDigits(tY) and IsDigits(tM) and IsDigits(tD)) return false end
    nY = Number(tY) nMo = Number(tM) nDa = Number(tD)
    if nMo < 1 or nMo > 12 return false end
    xDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    nMax = xDays[nMo]
    if nMo = 2 and IsLeapYear(nY) nMax = 29 end
    if nDa < 1 or nDa > nMax return false end
    return true
end
# RFC 3339: YYYY-MM-DDTHH:MM:SS, an optional fraction, then Z or +HH:MM / -HH:MM.
func IsDateTime(xS)
    if Len(xS) < 20 return false end
    if not IsDate(SubStr(xS, 1, 10)) return false end
    if Upper(xS[11]) != "T" return false end
    if xS[14] != ":" or xS[17] != ":" return false end
    tH = SubStr(xS, 12, 2) tMi = SubStr(xS, 15, 2) tS = SubStr(xS, 18, 2)
    if not (IsDigits(tH) and IsDigits(tMi) and IsDigits(tS)) return false end
    if Number(tH) > 23 or Number(tMi) > 59 or Number(tS) > 60 return false end
    nI = 20
    nN = Len(xS)
    if xS[nI] = "."
        nI++
        nStart = nI
        while nI <= nN and IsDigit(xS[nI]) nI++ end
        if nI = nStart return false end
    end
    if nI > nN return false end
    tRest = SubStr(xS, nI, nN - nI + 1)
    if Upper(tRest) = "Z" return true end
    if Len(tRest) != 6 return false end
    if tRest[1] != "+" and tRest[1] != "-" return false end
    if tRest[4] != ":" return false end
    if not (IsDigits(SubStr(tRest, 2, 2)) and IsDigits(SubStr(tRest, 5, 2))) return false end
    return true
end
# Haro compares strings with strcmp; dates written YYYY-MM-DD compare as text.
func Before(xA, xB)
    return StrCmp(xA, xB) < 0
end
func ReadText(tPath)
    return Read(tPath)
end
func StripCR(xS)
    if SubStr(xS, Char(13)) = 0 return xS end
    tOut = ""
    nN = Len(xS)
    for i = 1 to nN
        if Ascii(xS[i]) != 13 tOut += xS[i] end
    end
    return tOut
end
# ---------------------------------------------------------------- the run

class FeedRun
    tRoot = ""
    xProblems = []
    nEntries = 0
    oSchema = ""
    xItemSchema = ""
    xConfig = ""      # radar.yaml, read and checked by LoadConfig
    tConfig = ""        # the same, as the bytes of app/config.json
    xVoice = []         # the names a text of radar.yaml may use, with their values (Voice)
    xEntries = []       # [ [cFile, aData], ... ]
    bQuiet = false          # the guard sets it: problems are kept and not printed
    xIndex = ""       # what the last Finish built, for the guard to read
    xFeed = ""
    tIndex = ""
    tFeed = ""

    def Problem(tWhere, tMsg)
        xProblems + (tWhere + ": " + tMsg)
        Say("REFUSED " + tWhere + ": " + tMsg)
    end
    # Haro stores a COPY of an object, so the schema check cannot call back into this run:
    # it keeps what it found, and the run takes it here.
    def Drain
        xSaid = oSchema.xSaid
        nN = Len(xSaid)
        for i = 1 to nN
            xProblems + xSaid[i]
            Say("REFUSED " + xSaid[i])
        end
        oSchema.xSaid = []
    end
    # The whole run over this repository: generate writes the feeds, check only compares them.
    def Go(tMode)
        if not Prepare() return end
        KeyCheck()
        if ConfOn("checks.affirm") AffirmScan() end
        ReadEntries()
        LessonsCheck()
        MapCheck()
        Finish(tMode)
    end
    # map/estate.json is the estate as Radar reads it: layers, projects, domains, concerns. Every
    # entry's areas must name a project of the map (by id or alias, or a dotted sub-area of one), and
    # its domains and concerns must be ids of the map, so the site never places a signal nowhere.
    def MapCheck
        tMapRel = Conf("map")
        if tMapRel = "" tMapRel = "map/estate.json" end
        tPath = tRoot + "/" + tMapRel
        if not FExists(tPath)
            Problem(tMapRel, "is the map every entry is placed on (radar.yaml, map), and this run reads it")
            return
        end
        oReader = new JsonReader
        try
            xM = oReader.Parse(StripCR(Read(tPath)), tMapRel)
        catch e
            Problem("map/estate.json", "is not valid JSON: " + e.Message())
            return
        end
        if JKind(xM) != "object"
            Problem("map/estate.json", "holds one object")
            return
        end
        xLayers = MapIds(xM, "layers")
        xDomains = MapIds(xM, "domains")
        xConcerns = MapIds(xM, "concerns")
        xNames = []
        if not JHas(xM, "projects") or JKind(JGet(xM, "projects")) != "array"
            Problem("map/estate.json", 'holds a "projects" array')
            return
        end
        xPs = JItems(JGet(xM, "projects"))
        nP = Len(xPs)
        for i = 1 to nP
            xJP = xPs[i]
            if JKind(xJP) != "object" or not JHas(xJP, "id") or not JHas(xJP, "name") or not JHas(xJP, "layer") or not JHas(xJP, "line")
                Problem("map/estate.json", "project " + String(i) + " has an id, a name, a layer and a line")
                loop
            end
            tId = JGet(xJP, "id")
            if Find(xNames, tId) > 0 Problem("map/estate.json", "names " + tId + " twice") end
            xNames + tId
            if Find(xLayers, JGet(xJP, "layer")) = 0
                Problem("map/estate.json", "project " + tId + " sits on layer " + JGet(xJP, "layer") + ", and the map has no layer with that id")
            end
            if JHas(xJP, "link")
                tLink = JGet(xJP, "link")
                if not IsString(tLink) or Left(tLink, 8) != "https://"
                    Problem("map/estate.json", "project " + tId + " links to an https:// address")
                end
            end
            if JHas(xJP, "aliases")
                xAs = JItems(JGet(xJP, "aliases"))
                nA = Len(xAs)
                for j = 1 to nA
                    if Find(xNames, xAs[j]) > 0 Problem("map/estate.json", "names " + xAs[j] + " twice") end
                    xNames + xAs[j]
                end
            end
        end
        nE = Len(xEntries)
        for i = 1 to nE
            xData = xEntries[i][2]
            tWhere = xEntries[i][1]
            if JHas(xData, "areas")
                xVs = JItems(JGet(xData, "areas"))
                nV = Len(xVs)
                for j = 1 to nV
                    if not MapNames(xNames, xVs[j])
                        Problem(tWhere, "area " + xVs[j] + " names no project of map/estate.json")
                    end
                end
            end
            MapField(tWhere, xData, "domains", xDomains)
            MapField(tWhere, xData, "concerns", xConcerns)
        end
    end
    # The ids of one list of the map, refusing a list that is missing or an item with no id.
    def MapIds(xM, tKey)
        xIds = []
        if not JHas(xM, tKey) or JKind(JGet(xM, tKey)) != "array"
            Problem("map/estate.json", 'holds a "' + tKey + '" array')
            return xIds
        end
        xI = JItems(JGet(xM, tKey))
        nI = Len(xI)
        for i = 1 to nI
            if JKind(xI[i]) != "object" or not JHas(xI[i], "id") or not JHas(xI[i], "name")
                Problem("map/estate.json", tKey + " item " + String(i) + " has an id and a name")
                loop
            end
            tId = JGet(xI[i], "id")
            if Find(xIds, tId) > 0 Problem("map/estate.json", tKey + " names " + tId + " twice") end
            xIds + tId
        end
        return xIds
    end
    # An area matches by its whole name, or by the project it is a dotted sub-area of.
    def MapNames(xNames, tArea)
        if Find(xNames, tArea) > 0 return true end
        nDot = SubStr(tArea, ".")
        if nDot > 1 and Find(xNames, Left(tArea, nDot - 1)) > 0 return true end
        return false
    end
    def MapField(tWhere, xData, tKey, xIds)
        if not JHas(xData, tKey) return end
        xVs = JItems(JGet(xData, tKey))
        nV = Len(xVs)
        for j = 1 to nV
            if Find(xIds, xVs[j]) = 0
                Problem(tWhere, tKey + " value " + xVs[j] + " is not an id of map/estate.json")
            end
        end
    end
    # app/lessons.json is what the radar site shows under Build and Learn. It must be valid JSON, and
    # every key under "entries" must name an entry that exists, so the site never shows an orphan.
    def LessonsCheck
        tPath = tRoot + "/app/lessons.json"
        if not FExists(tPath) return end
        oReader = new JsonReader
        try
            xL = oReader.Parse(StripCR(Read(tPath)), "app/lessons.json")
        catch e
            Problem("app/lessons.json", "is not valid JSON: " + e.Message())
            return
        end
        if JKind(xL) != "object" or not JHas(xL, "entries")
            Problem("app/lessons.json", 'holds an object with an "entries" object, keyed by entry id')
            return
        end
        xJE = JGet(xL, "entries")
        if JKind(xJE) != "object"
            Problem("app/lessons.json", '"entries" is an object keyed by entry id')
            return
        end
        xIds = []
        nE = Len(xEntries)
        for i = 1 to nE
            xIds + JGet(xEntries[i][2], "id")
        end
        xKeys = JKeys(xJE)
        nK = Len(xKeys)
        for i = 1 to nK
            if Find(xIds, xKeys[i]) = 0
                Problem("app/lessons.json", "has lessons for " + xKeys[i] + ", and there is no entry with that id")
            end
        end
    end
    # ------------------------------------------------------------ public pages speak affirmatively
    #
    # A public page says what Softanza is and does; it never lists what has not been done, shown or
    # measured. Each line of README.md, docs/, digests/ and every entry is read for that class of
    # phrase. tools/affirm-allow.txt lists the lines that may keep one, each with its reason.

    def AffirmPhrases
        return ["not yet", "nobody has", "never been", "limit:", "does not exist", "doesn't exist",
                "not built", "is missing", "are missing", "what is missing", "still on ",
                "only by one", "protected only by", "has no ", "have no ", "nothing in stzlib",
                "nothing in softanza", "we have not", "not checked"]
    end
    def AffirmScan
        xAllow = AffirmAllow()
        xFiles = ["README.md"]
        xDirs = ["docs", "digests"]
        nD = Len(xDirs)
        for d = 1 to nD
            xIn = Dir(tRoot + "/" + xDirs[d])
            nIn = Len(xIn)
            for i = 1 to nIn
                if xIn[i][2] = 0 and Right(xIn[i][1], 3) = ".md"
                    xFiles + (xDirs[d] + "/" + xIn[i][1])
                end
            end
        end
        xYears = Dir(tRoot + "/items")
        nY = Len(xYears)
        for y = 1 to nY
            if xYears[y][2] = 1
                xIn = Dir(tRoot + "/items/" + xYears[y][1])
                nIn = Len(xIn)
                for i = 1 to nIn
                    if xIn[i][2] = 0 and Right(xIn[i][1], 3) = ".md"
                        xFiles + ("items/" + xYears[y][1] + "/" + xIn[i][1])
                    end
                end
            end
        end
        nF = Len(xFiles)
        for f = 1 to nF
            xLines = Str2List(StripCR(Read(tRoot + "/" + xFiles[f])))
            nL1 = Len(xLines)
            for i = 1 to nL1
                AffirmLine(xFiles[f], i, xLines[i], xAllow)
            end
        end
    end
    # One line of one public page. The guard calls this directly with lines it wrote.
    def AffirmLine(tFile, nLine, tLine, xAllow)
        tLow = Lower(tLine)
        xPs = AffirmPhrases()
        nP = Len(xPs)
        for p = 1 to nP
            if SubStr(tLow, xPs[p]) > 0 and not AffirmAllowed(tFile, tLow, xAllow)
                Problem(tFile + ":" + String(nLine), "a public page lists what is missing (" + xPs[p] +
                        "); say what holds or what is proposed, or allow the line in tools/affirm-allow.txt with its reason")
            end
        end
    end
    def AffirmAllowed(tFile, tLow, xAllow)
        nA = Len(xAllow)
        for a = 1 to nA
            if xAllow[a][1] = tFile and SubStr(tLow, xAllow[a][2]) > 0 return true end
        end
        return false
    end
    # tools/affirm-allow.txt: one line each, "file | words from the line | reason". A line with no
    # reason is refused, so nothing is allowed without saying why.
    def AffirmAllow
        xOut = []
        tPath = tRoot + "/tools/affirm-allow.txt"
        if not FExists(tPath) return xOut end
        xLines = Str2List(StripCR(Read(tPath)))
        nL1 = Len(xLines)
        for i = 1 to nL1
            tL = Trim(xLines[i])
            if tL = "" or Left(tL, 1) = "#" loop end
            nN1 = SubStr(tL, " | ")
            if nN1 = 0
                Problem("tools/affirm-allow.txt:" + String(i), "a line is: file | words from the line | reason")
                loop
            end
            tFile = Trim(Left(tL, nN1 - 1))
            tRest = SubStr(tL, nN1 + 3, Len(tL) - nN1 - 2)
            nN2 = SubStr(tRest, " | ")
            if nN2 = 0 or Trim(SubStr(tRest, nN2 + 3, Len(tRest) - nN2 - 2)) = ""
                Problem("tools/affirm-allow.txt:" + String(i), "every allowed line gives its reason")
                loop
            end
            xOut + [tFile, Lower(Trim(Left(tRest, nN2 - 1)))]
        end
        return xOut
    end
    # Loads the item schema. Returns 0 when the run cannot start.
    def Prepare
        oSchema = new SchemaCheck
        oSchema.tDir = tRoot + "/schema"
        if not FExists(oSchema.tDir + "/item.schema.json")
            Problem("tools/feed.haro", "run it from the repository root: schema/item.schema.json is not here")
            return false
        end
        xItemSchema = oSchema.SchemaFile("item.schema.json")
        Drain()
        if not IsList(xItemSchema) return false end
        return LoadConfig()
    end
    # radar.yaml: everything that belongs to the project this watch serves (docs/ADOPT.md). It is
    # read with the YAML reader below and checked against schema/config.schema.json; the run does not
    # start without it, because every URL and name the feed carries comes from it.
    def LoadConfig
        tPath = tRoot + "/radar.yaml"
        if not FExists(tPath)
            Problem("radar.yaml", "is this watch's configuration, and the run reads it first (docs/ADOPT.md)")
            return false
        end
        return LoadConfigText(Read(tPath))
    end
    # The same, from a text: the guard hands it configurations broken on purpose.
    def LoadConfigText(tText)
        oY = new YamlReader
        try
            xConfig = oY.Parse(tText, "radar.yaml")
        catch e
            Problem("radar.yaml", e.Message())
            return false
        end
        xConfigSchema = oSchema.SchemaFile("config.schema.json")
        Drain()
        if not IsList(xConfigSchema) return false end
        nBefore = Len(xProblems)
        oSchema.Check(xConfig, xConfigSchema, "radar.yaml", "")
        Drain()
        if Len(xProblems) > nBefore return false end
        Voice()
        if Len(xProblems) > nBefore return false end
        tConfig = JWrite(xConfig, 0) + Char(10)
        return true
    end
    # The project's own voice: a text of radar.yaml may say {project}, {topic}, {watch} or {title},
    # and is published with the configuration's values in their place, so a file copied to another
    # project speaks for that project once its names change. {week} is left for the site, which
    # fills it on the page of an earlier week. Any other {name} is refused, so a typo never reaches a reader.
    def Voice
        xVoice = [["{project}", Conf("project.name")], ["{topic}", Conf("watch.topic")], ["{watch}", Conf("watch.name")]]
        xVoice + ["{title}", VoiceText(Conf("watch.title"), ".watch.title")]
        xConfig = VoiceWalk(xConfig, "")
    end
    def VoiceWalk(xV, tWhere)
        if IsString(xV) return VoiceText(xV, tWhere) end
        if not IsList(xV) return xV end
        if Len(xV) = 2 and IsString(xV[1]) and xV[1] = "{"
            xPs = xV[2]
            nP = Len(xPs)
            for i = 1 to nP
                xPs[i][2] = VoiceWalk(xPs[i][2], tWhere + "." + xPs[i][1])
            end
            return ["{", xPs]
        end
        if Len(xV) = 2 and IsString(xV[1]) and xV[1] = "["
            xI = xV[2]
            nI = Len(xI)
            for i = 1 to nI
                xI[i] = VoiceWalk(xI[i], tWhere + "[" + String(i) + "]")
            end
            return ["[", xI]
        end
        return xV
    end
    def VoiceText(tC, tWhere)
        if SubStr(tC, "{") = 0 return tC end
        nV = Len(xVoice)
        for k = 1 to nV
            tC = SubStr(tC, xVoice[k][1], xVoice[k][2])
        end
        tRest = SubStr(tC, "{week}", "")
        nOpen = SubStr(tRest, "{")
        if nOpen > 0
            nClose = SubStr(tRest, "}")
            if nClose > nOpen
                Problem("radar.yaml", SubStr(tWhere, 2, Len(tWhere) - 1) + " names " + SubStr(tRest, nOpen, nClose - nOpen + 1) + "; a text may name {project}, {topic}, {watch}, {title} or {week}")
            end
        end
        return tC
    end
    # One value of the configuration by its dotted path, "watch.repository".
    def Conf(tPath)
        xV = xConfig
        tPart = ""
        tP = tPath + "."
        nP = Len(tP)
        for i = 1 to nP
            if tP[i] = "."
                if JKind(xV) != "object" or not JHas(xV, tPart) return "" end
                xV = JGet(xV, tPart)
                tPart = ""
            else
                tPart += tP[i]
            end
        end
        return xV
    end
    # The key radar.yaml publishes for the site and the bar must be the key the feed is checked
    # against, keys/allowed_signers, for the signer it names.
    def KeyCheck
        tPath = tRoot + "/keys/allowed_signers"
        if not FExists(tPath)
            Problem("keys/allowed_signers", "holds the public key the feed is signed with (docs/ADOPT.md, step 4)")
            return
        end
        tWant = Conf("feed.signer") + " " + 'namespaces="' + Conf("feed.namespace") + '" ssh-ed25519 ' + Conf("feed.key")
        xLines = Str2List(StripCR(Read(tPath)))
        nL1 = Len(xLines)
        for i = 1 to nL1
            if Trim(xLines[i]) = tWant return end
        end
        Problem("radar.yaml", "feed.key, feed.signer and feed.namespace must match a line of keys/allowed_signers: " + tWant)
    end
    # digests/<YYYY-Www>.md, as a sorted JSON list of weeks: the weeks a survey has closed.
    def DigestWeeks
        xWs = []
        xIn = Dir(tRoot + "/digests")
        nIn = Len(xIn)
        for i = 1 to nIn
            tN = xIn[i][1]
            if xIn[i][2] = 0 and Len(tN) = 11 and Right(tN, 3) = ".md" and tN[5] = "-" and tN[6] = "W"
                xWs + Left(tN, 8)
            end
        end
        xWs = Sort(xWs)
        return JWrite(["[", xWs], 0) + Char(10)
    end
    def ConfOn(tPath)
        xV = Conf(tPath)
        return IsList(xV) and Len(xV) = 1 and xV[1] = "t"
    end
    # Cross-checks the entries read so far, builds both feeds and checks them. cMode "generate"
    # writes changed files, "check" compares them with what is committed, "none" touches no file.
    def Finish(tMode)
        nEntries = Len(xEntries)
        if nEntries = 0
            Problem("items/", "there is no entry, so the feed has no date to carry")
            return
        end
        CrossChecks()
        if Len(xProblems) > 0
            Say("nothing written: the entries above must be corrected first")
            return
        end

        SortEntries()
        xIndex = BuildIndex()
        xFeed = BuildJsonFeed()

        xIndexSchema = oSchema.SchemaFile("feed.schema.json")
        Drain()
        if not IsList(xIndexSchema) return end
        oSchema.Check(xIndex, xIndexSchema, "feed/index.json", "")
        Drain()
        CheckJsonFeed(xFeed)
        if Len(xProblems) > 0
            Say("nothing written: the generated feed does not pass its own check")
            return
        end

        tIndex = JWrite(xIndex, 0) + Char(10)
        tFeed = JWrite(xFeed, 0) + Char(10)
        if tMode = "none" return end
        Settle(tMode, "feed/index.json", tIndex)
        Settle(tMode, "feed/feed.json", tFeed)
        Settle(tMode, "app/config.json", tConfig)      # the site and the bar read the configuration here
        Settle(tMode, "app/digests.json", DigestWeeks())  # the weeks surveyed: the site opens on the newest
        Settle(tMode, "llms.txt", BuildLlms())             # the site for agents and language models
        Settle(tMode, "llms-full.txt", BuildLlmsFull())
    end
    def Say(tLine)
        if not bQuiet FWrite(stdout, tLine + Char(10)) end
    end
    # In check mode, a committed feed that differs from what the entries generate is a problem.
    # In generate mode, the file is written only when its bytes change.
    def Settle(tMode, tRel, tBytes)
        tPath = tRoot + "/" + tRel
        tOld = ""
        if FExists(tPath) tOld = Read(tPath) end
        if tOld = tBytes
            Say("unchanged " + tRel + " (" + String(Len(tBytes)) + " bytes)")
            return
        end
        if tMode = "check"
            Problem(tRel, "is not what the entries generate: run haro tools/feed.haro and commit the result")
            return
        end
        Write(tPath, tBytes)
        Say("written   " + tRel + " (" + String(Len(tBytes)) + " bytes)")
    end
    def ReadEntries
        tItems = tRoot + "/items"
        xTop = Dir(tItems)
        nTop = Len(xTop)
        for i = 1 to nTop
            tName = xTop[i][1]
            if xTop[i][2] = 0
                if tName != "README.md"
                    Problem("items/" + tName, "an entry lives in a year folder, items/<year>/<id>.md")
                end
                loop
            end
            if not (Len(tName) = 4 and IsDigits(tName))
                Problem("items/" + tName + "/", "a folder under items/ is a year, four digits")
                loop
            end
            xYear = Dir(tItems + "/" + tName)
            nYear = Len(xYear)
            for j = 1 to nYear
                tFile = xYear[j][1]
                tRel = "items/" + tName + "/" + tFile
                if xYear[j][2] = 1
                    Problem(tRel + "/", "a year folder holds entries only, no folders")
                    loop
                end
                if Right(tFile, 3) != ".md"
                    Problem(tRel, "an entry is a .md file")
                    loop
                end
                AddEntryText(tRel, tName, tFile, Read(tRoot + "/" + tRel))
            end
        end
    end
    # One entry, given as the text of its file: the guard calls this with texts it has broken.
    def AddEntryText(tRel, tYear, tFile, tFileText)
        tText = StripCR(tFileText)
        xLines = Str2List(tText)
        nLines = Len(xLines)
        nOpen = 0
        nClose = 0
        for i = 1 to nLines
            if Trim(xLines[i]) = "```json"
                nOpen = i
                exit
            end
        end
        if nOpen = 0
            Problem(tRel, "has no fenced json block, so it has no data")
            return
        end
        for i = nOpen + 1 to nLines
            if Trim(xLines[i]) = "```"
                nClose = i
                exit
            end
        end
        if nClose = 0
            Problem(tRel, "its json block is never closed")
            return
        end
        tJson = ""
        for i = nOpen + 1 to nClose - 1
            tJson += xLines[i] + Char(10)
        end

        oReader = new JsonReader
        try
            xData = oReader.Parse(tJson, tRel)
        catch e
            Problem(tRel, "its json block is not valid JSON: " + e.Message())
            return
        end

        nBefore = Len(xProblems)
        oSchema.Check(xData, xItemSchema, tRel, "")
        Drain()
        if Len(xProblems) > nBefore return end
        EntryRules(tRel, tYear, tFile, xData)
        if Len(xProblems) > nBefore return end
        xEntries + [tRel, xData]
    end
    # What the schema cannot say, docs/FEED.md does.
    def EntryRules(tRel, tYear, tFile, xData)
        tId = JGet(xData, "id")
        tDate = JGet(xData, "date")
        if tFile != tId + ".md"
            Problem(tRel, "the file is named after its id, so it should be " + tId + ".md")
        end
        if Left(tId, 10) != tDate
            Problem(tRel, "the id starts with the entry's date, " + tDate + ", and this one starts with " + Left(tId, 10))
        end
        if Left(tDate, 4) != tYear
            Problem(tRel, "an entry dated " + tDate + " lives in items/" + Left(tDate, 4) + "/")
        end
        if SubStr(JGet(xData, "title"), Char(10)) > 0
            Problem(tRel, "the title is one line")
        end
        if JHas(xData, "url")
            Problem(tRel, "an entry does not write its url: the generator adds it to the index")
        end
        if JHas(xData, "updated")
            if Before(JGet(xData, "updated"), tDate)
                Problem(tRel, "updated, " + JGet(xData, "updated") + ", is before the entry's date")
            end
        end
        if not Before(tDate, JGet(xData, "review_by"))
            Problem(tRel, "review_by, " + JGet(xData, "review_by") + ", must come after the entry's date")
        end

        # notice holds one sentence per audience listed, and only for those
        xAud = JItems(JGet(xData, "audiences"))
        xNotice = JGet(xData, "notice")
        xKeys = JKeys(xNotice)
        nK = Len(xKeys)
        for i = 1 to nK
            if Find(xAud, xKeys[i]) = 0
                Problem(tRel, "notice has a sentence for " + xKeys[i] + ", which audiences does not list")
            end
        end
        nA = Len(xAud)
        for i = 1 to nA
            if Find(xKeys, xAud[i]) = 0
                Problem(tRel, "audiences lists " + xAud[i] + ", and notice has no sentence for it")
            end
        end
        ActionDates(tRel, xData)
    end
    # Every action carries the day it reached each stage, so the radar site can say how fast Softanza
    # reacts. A stage is dated between the entry's date and the day the entry was last written, the
    # stages run in order, the current state has its date, and no stage beyond it is dated.
    def ActionDates(tRel, xData)
        if not JHas(xData, "actions") return end
        xStages = ["proposed", "routed", "in-progress", "done"]
        tDate = JGet(xData, "date")
        tLast = tDate
        if JHas(xData, "updated") tLast = JGet(xData, "updated") end
        xAct = JItems(JGet(xData, "actions"))
        nAct = Len(xAct)
        for i = 1 to nAct
            xJA = xAct[i]
            tWhere = "action " + String(i) + " (" + JGet(xJA, "area") + ")"
            tState = JGet(xJA, "state")
            if not JHas(xJA, "dates")
                Problem(tRel, tWhere + " has no dates: give the day it reached each stage, at least proposed")
                loop
            end
            xDs = JGet(xJA, "dates")
            if JKind(xDs) != "object"
                Problem(tRel, tWhere + " dates is an object of stage: day")
                loop
            end
            xKs = JKeys(xDs)
            nK = Len(xKs)
            for j = 1 to nK
                tK = xKs[j]
                if Find(xStages, tK) = 0 and tK != "declined"
                    Problem(tRel, tWhere + " dates a stage named " + tK + ", and the stages are proposed, routed, in-progress, done, declined")
                    loop
                end
                tD = JGet(xDs, tK)
                if not IsString(tD) or not IsDate(tD)
                    Problem(tRel, tWhere + " dates " + tK + " with something that is not a YYYY-MM-DD day")
                    loop
                end
                if Before(tD, tDate)
                    Problem(tRel, tWhere + " reached " + tK + " on " + tD + ", before the entry's date " + tDate)
                end
                if Before(tLast, tD)
                    Problem(tRel, tWhere + " reached " + tK + " on " + tD + ", after the entry was last written (" + tLast + "): set updated")
                end
            end
            if not JHas(xDs, "proposed")
                Problem(tRel, tWhere + " dates the day it was proposed")
            end
            if not JHas(xDs, tState)
                Problem(tRel, tWhere + " is " + tState + " and does not date that stage")
            end
            nNow = Find(xStages, tState)
            tPrev = ""
            nS = Len(xStages)
            for j = 1 to nS
                if not JHas(xDs, xStages[j]) loop end
                if nNow > 0 and j > nNow
                    Problem(tRel, tWhere + " is " + tState + " and dates a later stage, " + xStages[j])
                end
                tD = JGet(xDs, xStages[j])
                if tPrev != "" and Before(tD, tPrev)
                    Problem(tRel, tWhere + " reached " + xStages[j] + " on " + tD + ", before an earlier stage (" + tPrev + ")")
                end
                tPrev = tD
            end
        end
    end
    def CrossChecks
        nN = Len(xEntries)
        xIds = []
        for i = 1 to nN
            xIds + JGet(xEntries[i][2], "id")
        end
        for i = 1 to nN
            for j = i + 1 to nN
                if xIds[i] = xIds[j]
                    Problem(xEntries[j][1], "its id " + xIds[j] + " is already used by " + xEntries[i][1])
                end
            end
        end
        for i = 1 to nN
            xData = xEntries[i][2]
            if JHas(xData, "supersedes")
                tTarget = JGet(xData, "supersedes")
                if tTarget = xIds[i]
                    Problem(xEntries[i][1], "an entry cannot supersede itself")
                elseif Find(xIds, tTarget) = 0
                    Problem(xEntries[i][1], "supersedes " + tTarget + ", and there is no entry with that id")
                end
            end
        end
    end
    # Newest date first, then by id.
    def SortEntries
        nN = Len(xEntries)
        for i = 2 to nN
            xJ = i
            while xJ > 1 and ComesFirst(xEntries[xJ][2], xEntries[xJ - 1][2])
                xTmp = xEntries[xJ]
                xEntries[xJ] = xEntries[xJ - 1]
                xEntries[xJ - 1] = xTmp
                xJ--
            end
        end
    end
    def ComesFirst(xA, xB)
        xDa = JGet(xA, "date") xDb = JGet(xB, "date")
        if xDa != xDb return Before(xDb, xDa) end
        return Before(JGet(xA, "id"), JGet(xB, "id"))
    end
    def EntryUrl(xData)
        tId = JGet(xData, "id")
        return Conf("watch.repository") + "/blob/main/items/" + Left(tId, 4) + "/" + tId + ".md"
    end
    # The site for agents and language models (the llms.txt convention): the site itself is drawn by a
    # script, so an agent that fetches its address reads almost nothing. llms.txt says what the watch is
    # and where its data lives -- the signed feeds, one Markdown file per signal, the documents -- and
    # llms-full.txt carries every signal in plain text. Both are generated from the entries, like the feed.
    def Str(xObj, tKey)
        xV = JGet(xObj, tKey)
        if IsString(xV) return xV end
        return ""
    end
    def PageUrl(xData)
        tId = JGet(xData, "id")
        return Conf("watch.pages") + "items/" + Left(tId, 4) + "/" + tId + ".md"
    end
    def BuildLlms
        tNL = Char(10)
        tP = Conf("watch.pages")
        tC = "# " + Conf("watch.title") + tNL + tNL
        tC += "> " + Conf("watch.tagline") + ". " + Conf("home.promise") + tNL + tNL
        tC += "Every file below is plain data or plain text. The two feed files are signed with SSH (Ed25519, namespace " +
             Conf("feed.namespace") + ", signer " + Conf("feed.signer") + "): check a signature before trusting a feed." + tNL + tNL
        tC += "## Feeds" + tNL
        tC += "- [Feed index](" + tP + "feed/index.json): every entry as data; its signature is feed/index.json.sig, its contract docs/FEED.md" + tNL
        tC += "- [JSON Feed 1.1](" + tP + "feed/feed.json): the same entries for feed readers; signature feed/feed.json.sig" + tNL
        tC += "- [Signer key](" + tP + "keys/allowed_signers): the public key both signatures are checked against" + tNL
        tC += "- [Configuration](" + tP + "app/config.json): the project, its readers, its stances and where its map is" + tNL
        tC += "- [Map](" + tP + Conf("map") + "): the project's layers, parts, domains and concerns" + tNL + tNL
        tC += "## Signals, newest first" + tNL
        nN = Len(xEntries)
        for i = 1 to nN
            xO = xEntries[i][2]
            tC += "- [" + Str(xO, "title") + "](" + PageUrl(xO) + "): " + Str(xO, "level") + ", " + Str(xO, "kind") + ", " +
                 Str(xO, "stance") + ", " + Str(xO, "date") + ". " + Str(xO, "summary") + tNL
        end
        tC += tNL + "## About" + tNL
        tC += "- [Why](" + tP + "docs/WHY.md): what the watch answers and the requirements behind it" + tNL
        tC += "- [Method](" + tP + "docs/METHOD.md): how a signal is read, judged, written and published" + tNL
        tC += "- [Feed contract](" + tP + "docs/FEED.md): every field of an entry, and how a program shows a notice" + tNL
        tC += "- [Run your own](" + tP + "docs/ADOPT.md): the same watch for another project, from one file" + tNL
        tC += "- [MCP server](" + tP + "docs/MCP.md): ask the radar from any MCP agent (tools/mcp.haro, read-only, checks the signature first)" + tNL + tNL
        tC += "## Optional" + tNL
        tC += "- [Full text](" + tP + "llms-full.txt): every signal, with its notices for each reader, its actions and its sources" + tNL
        return tC
    end
    def BuildLlmsFull
        tNL = Char(10)
        tC = "# " + Conf("watch.title") + ": every signal, in full" + tNL + tNL
        tC += "> " + Conf("watch.tagline") + ". Generated from the signed feed (" + Conf("watch.pages") + "feed/index.json); the feed is the reference." + tNL
        nN = Len(xEntries)
        for i = 1 to nN
            xO = xEntries[i][2]
            tC += tNL + "## " + Str(xO, "title") + tNL + tNL
            tC += "- id: " + Str(xO, "id") + tNL + "- date: " + Str(xO, "date") + tNL + "- level: " + Str(xO, "level") + tNL +
                 "- kind: " + Str(xO, "kind") + tNL + "- stance: " + Str(xO, "stance") + tNL + "- relevance: " + Str(xO, "relevance") + tNL +
                 "- page: " + PageUrl(xO) + tNL + tNL
            tC += Str(xO, "summary") + tNL
            xN = JGet(xO, "notice")
            if JKind(xN) = "object"
                tC += tNL + "For each reader:" + tNL
                xPs = xN[2]
                nP = Len(xPs)
                for k = 1 to nP
                    if IsString(xPs[k][2]) tC += "- " + xPs[k][1] + ": " + xPs[k][2] + tNL end
                end
            end
            xA = JGet(xO, "actions")
            if JKind(xA) = "array"
                xAs = JItems(xA)
                nA = Len(xAs)
                if nA > 0 tC += tNL + "Proposed:" + tNL end
                for k = 1 to nA
                    tC += "- " + Str(xAs[k], "area") + ": " + Str(xAs[k], "do") + " (" + Str(xAs[k], "state") + ")" + tNL
                end
            end
            xS = JGet(xO, "sources")
            if JKind(xS) = "array"
                xSs = JItems(xS)
                nS = Len(xSs)
                if nS > 0 tC += tNL + "Sources:" + tNL end
                for k = 1 to nS
                    tC += "- " + Str(xSs[k], "title") + ": " + Str(xSs[k], "url") + tNL
                end
            end
        end
        return tC
    end
    # The newest date or updated among the entries, at midnight UTC: an unchanged feed
    # regenerates to the same bytes.
    def NewestDay
        tMax = ""
        nN = Len(xEntries)
        for i = 1 to nN
            xData = xEntries[i][2]
            tD = JGet(xData, "date")
            if tMax = "" or Before(tMax, tD) tMax = tD end
            if JHas(xData, "updated")
                tU = JGet(xData, "updated")
                if Before(tMax, tU) tMax = tU end
            end
        end
        return tMax + "T00:00:00Z"
    end
    def BuildIndex
        xItems = []
        nN = Len(xEntries)
        for i = 1 to nN
            xData = xEntries[i][2]
            xPairs = xData[2]
            xPairs + ["url", EntryUrl(xData)]
            xItems + ["{", xPairs]
        end
        return ["{", [
            ["feed", "radar"],
            ["version", ["#", "1"]],
            ["updated", NewestDay()],
            ["home", Conf("watch.repository")],
            ["title", Conf("watch.title")],
            ["items", ["[", xItems]]
        ]]
    end
    # The same entries as a JSON Feed 1.1 (docs/FEED.md, "The JSON Feed").
    def BuildJsonFeed
        xItems = []
        nN = Len(xEntries)
        for i = 1 to nN
            xData = xEntries[i][2]
            xTags = [JGet(xData, "kind"), JGet(xData, "stance"), JGet(xData, "level")]
            if JHas(xData, "tags")
                xOwn = JItems(JGet(xData, "tags"))
                nT = Len(xOwn)
                for t = 1 to nT
                    xTags + xOwn[t]
                end
            end
            tDate = JGet(xData, "date")
            xPairs = [
                ["id", JGet(xData, "id")],
                ["url", EntryUrl(xData)],
                ["title", JGet(xData, "title")],
                ["summary", JGet(xData, "summary")],
                ["content_text", JGet(xData, "summary")],
                ["date_published", tDate + "T00:00:00Z"]
            ]
            if JHas(xData, "updated")
                tUp = JGet(xData, "updated")
                if tUp != tDate
                    xPairs + ["date_modified", tUp + "T00:00:00Z"]
                end
            end
            xPairs + ["tags", ["[", xTags]]
            xItems + ["{", xPairs]
        end
        return ["{", [
            ["version", "https://jsonfeed.org/version/1.1"],
            ["title", Conf("watch.title")],
            ["home_page_url", Conf("watch.repository")],
            ["feed_url", SubStr(Conf("watch.repository"), "https://github.com/", "https://raw.githubusercontent.com/") + "/main/feed/feed.json"],
            ["description", "A public watch on what is changing in " + Conf("watch.topic") + ", read from " + Conf("project.name") + "'s point of view."],
            ["language", Conf("watch.language")],
            ["items", ["[", xItems]]
        ]]
    end
    # What JSON Feed 1.1 requires of a feed and of each item.
    def CheckJsonFeed(xFeed)
        tW = "feed/feed.json"
        if JGet(xFeed, "version") != "https://jsonfeed.org/version/1.1"
            Problem(tW, "version is not https://jsonfeed.org/version/1.1")
        end
        if not JIsString(JGet(xFeed, "title"))
            Problem(tW, "has no title")
        end
        xItems = JItems(JGet(xFeed, "items"))
        nN = Len(xItems)
        if nN != nEntries
            Problem(tW, "carries " + String(nN) + " items for " + String(nEntries) + " entries")
        end
        for i = 1 to nN
            xJI = xItems[i]
            tId = JGet(xJI, "id")
            if not JIsString(tId)
                Problem(tW, "item " + String(i) + " has no id")
                loop
            end
            if not (JHas(xJI, "content_text") or JHas(xJI, "content_html"))
                Problem(tW, tId + " has neither content_text nor content_html")
            end
            if not IsDateTime(JGet(xJI, "date_published"))
                Problem(tW, tId + ": date_published is not an RFC 3339 date-time")
            end
            if JHas(xJI, "date_modified") and not IsDateTime(JGet(xJI, "date_modified"))
                Problem(tW, tId + ": date_modified is not an RFC 3339 date-time")
            end
        end
    end
end
# ---------------------------------------------------------------- JSON reader

class JsonReader
    tText = ""
    nPos = 1
    nSize = 0
    tWhere = ""

    def Parse(tSrc, tName)
        tText = tSrc
        nSize = Len(tSrc)
        nPos = 1
        tWhere = tName
        xV = ReadValue()
        SkipSpace()
        if nPos <= nSize Fail("there is text after the JSON value") end
        return xV
    end
    def Fail(tMsg)
        # the line, counted from the start of the block
        nLine = 1
        for i = 1 to nPos - 1
            if i <= nSize and Ascii(tText[i]) = 10 nLine++ end
        end
        Raise("line " + String(nLine) + " of the block: " + tMsg)
    end
    def SkipSpace
        while nPos <= nSize
            nB = Ascii(tText[nPos])
            if nB = 32 or nB = 9 or nB = 10 or nB = 13
                nPos++
            else
                exit
            end
        end
    end
    def ReadValue
        SkipSpace()
        if nPos > nSize Fail("the value ends early") end
        tC = tText[nPos]
        if tC = "{" return ReadObject() end
        if tC = "[" return ReadArray() end
        if tC = '"' return ReadString() end
        if tC = "t"
            Word("true")
            return ["t"]
        end
        if tC = "f"
            Word("false")
            return ["f"]
        end
        if tC = "n"
            Word("null")
            return ["n"]
        end
        if tC = "-" or IsDigit(tC) return ReadNumber() end
        Fail("unexpected character " + tC)
    end
    def Word(tWord)
        if SubStr(tText, nPos, Len(tWord)) != tWord Fail("expected " + tWord) end
        nPos += Len(tWord)
    end
    def ReadObject
        nPos++
        xPairs = []
        xSeen = []
        SkipSpace()
        if nPos <= nSize and tText[nPos] = "}"
            nPos++
            return ["{", xPairs]
        end
        while true
            SkipSpace()
            if nPos > nSize or tText[nPos] != '"' Fail("expected a key in double quotes") end
            tKey = ReadString()
            if Find(xSeen, tKey) > 0 Fail("the key " + tKey + " is written twice") end
            xSeen + tKey
            SkipSpace()
            if nPos > nSize or tText[nPos] != ":" Fail("expected : after the key " + tKey) end
            nPos++
            xV = ReadValue()
            xPairs + [tKey, xV]
            SkipSpace()
            if nPos > nSize Fail("the object is never closed") end
            tC = tText[nPos]
            nPos++
            if tC = "}" return ["{", xPairs] end
            if tC != "," Fail("expected , or } after the value of " + tKey) end
        end
    end
    def ReadArray
        nPos++
        xItems = []
        SkipSpace()
        if nPos <= nSize and tText[nPos] = "]"
            nPos++
            return ["[", xItems]
        end
        while true
            xV = ReadValue()
            xItems + xV
            SkipSpace()
            if nPos > nSize Fail("the array is never closed") end
            tC = tText[nPos]
            nPos++
            if tC = "]" return ["[", xItems] end
            if tC != "," Fail("expected , or ] in an array") end
        end
    end
    def ReadString
        nPos++
        tOut = ""
        while true
            if nPos > nSize Fail("a string is never closed") end
            tC = tText[nPos]
            nB = Ascii(tC)
            if tC = '"'
                nPos++
                return tOut
            end
            if nB < 32 Fail("a control character inside a string must be escaped") end
            if tC != "\"
                tOut += tC
                nPos++
                loop
            end
            nPos++
            if nPos > nSize Fail("a string ends on a backslash") end
            tE = tText[nPos]
            nPos++
            if tE = '"' tOut += '"'
            elseif tE = "\" tOut += "\"
            elseif tE = "/" tOut += "/"
            elseif tE = "b" tOut += Char(8)
            elseif tE = "f" tOut += Char(12)
            elseif tE = "n" tOut += Char(10)
            elseif tE = "r" tOut += Char(13)
            elseif tE = "t" tOut += Char(9)
            elseif tE = "u"
                xN = Hex4()
                if xN >= 55296 and xN <= 56319
                    if SubStr(tText, nPos, 2) != "\u" Fail("a high surrogate is not followed by a low one") end
                    nPos += 2
                    xN2 = Hex4()
                    if xN2 < 56320 or xN2 > 57343 Fail("a high surrogate is not followed by a low one") end
                    xN = 65536 + (xN - 55296) * 1024 + (xN2 - 56320)
                elseif xN >= 56320 and xN <= 57343
                    Fail("a low surrogate stands alone")
                end
                tOut += Utf8(xN)
            else
                Fail("unknown escape \" + tE)
            end
        end
    end
    def Hex4
        if nPos + 3 > nSize Fail("\u needs four hex digits") end
        tH = SubStr(tText, nPos, 4)
        for i = 1 to 4
            if SubStr("0123456789abcdefABCDEF", tH[i]) = 0 Fail("\u needs four hex digits") end
        end
        nPos += 4
        return Dec(tH)
    end
    def ReadNumber
        nStart = nPos
        if tText[nPos] = "-" nPos++ end
        if nPos > nSize or not IsDigit(tText[nPos]) Fail("a number needs a digit") end
        if tText[nPos] = "0"
            nPos++
        else
            while nPos <= nSize and IsDigit(tText[nPos]) nPos++ end
        end
        if nPos <= nSize and tText[nPos] = "."
            nPos++
            if nPos > nSize or not IsDigit(tText[nPos]) Fail("a fraction needs a digit") end
            while nPos <= nSize and IsDigit(tText[nPos]) nPos++ end
        end
        if nPos <= nSize and (tText[nPos] = "e" or tText[nPos] = "E")
            nPos++
            if nPos <= nSize and (tText[nPos] = "+" or tText[nPos] = "-") nPos++ end
            if nPos > nSize or not IsDigit(tText[nPos]) Fail("an exponent needs a digit") end
            while nPos <= nSize and IsDigit(tText[nPos]) nPos++ end
        end
        return ["#", SubStr(tText, nStart, nPos - nStart)]
    end
end
# ---------------------------------------------------------------- schema check
#
# The part of JSON Schema 2020-12 that schema/ uses. A keyword this check does not implement is
# refused by name, so a later schema cannot pass because nobody here read it.

class SchemaCheck
    tDir = ""
    xSaid = []       # what this check found, taken by FeedRun.Drain
    xCache = []      # [ [cName, oSchema], ... ]

    def SchemaFile(tName)
        nN = Len(xCache)
        for i = 1 to nN
            if xCache[i][1] = tName return xCache[i][2] end
        end
        tPath = tDir + "/" + tName
        if not FExists(tPath)
            xSaid + ("schema/" + tName + ": is referred to and does not exist")
            return ""
        end
        oReader = new JsonReader
        try
            xJS = oReader.Parse(StripCR(Read(tPath)), "schema/" + tName)
        catch e
            xSaid + ("schema/" + tName + ": is not valid JSON: " + e.Message())
            return ""
        end
        xCache + [tName, xJS]
        return xJS
    end
    def Say(tWhere, tPath, tMsg)
        if tPath = ""
            xSaid + (tWhere + ": " + tMsg)
        else
            xSaid + (tWhere + ": " + tPath + ": " + tMsg)
        end
    end
    def Check(xV, xJS, tWhere, tPath)
        if JKind(xJS) = "boolean"
            if xJS[1] = "f" Say(tWhere, tPath, "is not allowed here") end
            return
        end
        xKnown = ["$schema", "$id", "title", "description", "$ref", "allOf", "type", "const", "enum",
                  "required", "properties", "additionalProperties", "propertyNames", "minProperties",
                  "items", "minItems", "uniqueItems", "minLength", "pattern", "format"]
        xKeys = JKeys(xJS)
        nK = Len(xKeys)
        for i = 1 to nK
            if Find(xKnown, xKeys[i]) = 0
                Say(tWhere, tPath, "the schema uses " + xKeys[i] + ", which tools/feed.haro does not check yet")
            end
        end

        if JHas(xJS, "$ref")
            tRef = JGet(xJS, "$ref")
            nSlash = 0
            nRef = Len(tRef)
            for i = 1 to nRef
                if tRef[i] = "/" nSlash = i end
            end
            xRef = SchemaFile(SubStr(tRef, nSlash + 1, Len(tRef) - nSlash))
            if IsList(xRef) Check(xV, xRef, tWhere, tPath) end
        end
        if JHas(xJS, "allOf")
            xAll = JItems(JGet(xJS, "allOf"))
            nAll = Len(xAll)
            for i = 1 to nAll
                Check(xV, xAll[i], tWhere, tPath)
            end
        end

        xK = JKind(xV)
        tShown = tPath
        if tShown = "" tShown = "the entry" end

        if JHas(xJS, "type")
            tT = JGet(xJS, "type")
            if not IsString(tT)
                Say(tWhere, tPath, "the schema gives a list of types, which tools/feed.haro does not check yet")
                return
            end
            bOk = false
            if tT = xK bOk = true end
            if tT = "integer" and xK = "number"
                if SubStr(xV[2], ".") = 0 and SubStr(Lower(xV[2]), "e") = 0 bOk = true end
            end
            if not bOk
                Say(tWhere, tPath, "should be " + tT + " and is " + xK)
                return
            end
        end
        if JHas(xJS, "const")
            if not JEqual(xV, JGet(xJS, "const"))
                Say(tWhere, tPath, "should be " + JWrite(JGet(xJS, "const"), 0))
            end
        end
        if JHas(xJS, "enum")
            xE = JItems(JGet(xJS, "enum"))
            nE = Len(xE)
            bFound = false
            xShow = []
            for i = 1 to nE
                if JEqual(xV, xE[i]) bFound = true end
                xShow + JWrite(xE[i], 0)
            end
            if not bFound
                tList = ""
                for i = 1 to nE
                    if i > 1 tList += ", " end
                    tList += xShow[i]
                end
                tGot = "this value"
                if xK = "string" tGot = JQuote(xV) end
                Say(tWhere, tShown, tGot + " is not one of " + tList)
            end
        end

        if xK = "string"
            if JHas(xJS, "minLength")
                xMin = JGet(xJS, "minLength")
                if CodePoints(xV) < Number(xMin[2])
                    Say(tWhere, tShown, "is shorter than " + xMin[2] + " characters")
                end
            end
            if JHas(xJS, "pattern")
                oRx = new Pattern
                try
                    bMatch = oRx.Search(JGet(xJS, "pattern"), xV)
                catch e
                    Say(tWhere, tShown, "the schema's pattern cannot be read: " + e.Message())
                    bMatch = true
                end
                if not bMatch
                    Say(tWhere, tShown, JQuote(xV) + " does not match " + JGet(xJS, "pattern"))
                end
            end
            if JHas(xJS, "format")
                tF = JGet(xJS, "format")
                if tF = "date"
                    if not IsDate(xV) Say(tWhere, tShown, JQuote(xV) + " is not a date, YYYY-MM-DD") end
                elseif tF = "date-time"
                    if not IsDateTime(xV) Say(tWhere, tShown, JQuote(xV) + " is not an RFC 3339 date-time") end
                else
                    Say(tWhere, tShown, "the schema asks for format " + tF + ", which tools/feed.haro does not check yet")
                end
            end
        end

        if xK = "array"
            xI = JItems(xV)
            nI = Len(xI)
            if JHas(xJS, "minItems")
                xMin = JGet(xJS, "minItems")
                if nI < Number(xMin[2])
                    Say(tWhere, tShown, "needs at least " + xMin[2] + " item(s)")
                end
            end
            xUniq = ["f"]
            if JHas(xJS, "uniqueItems") xUniq = JGet(xJS, "uniqueItems") end
            if xUniq[1] = "t"
                for i = 1 to nI
                    for j = i + 1 to nI
                        if JEqual(xI[i], xI[j])
                            Say(tWhere, tShown, "item " + String(j) + " repeats item " + String(i))
                        end
                    end
                end
            end
            if JHas(xJS, "items")
                xIs = JGet(xJS, "items")
                for i = 1 to nI
                    Check(xI[i], xIs, tWhere, tPath + "[" + String(i) + "]")
                end
            end
        end

        if xK = "object"
            xOwn = JKeys(xV)
            nO = Len(xOwn)
            if JHas(xJS, "required")
                xR = JItems(JGet(xJS, "required"))
                nR = Len(xR)
                for i = 1 to nR
                    if not JHas(xV, xR[i])
                        Say(tWhere, tShown, "is missing " + xR[i])
                    end
                end
            end
            if JHas(xJS, "minProperties")
                xMin = JGet(xJS, "minProperties")
                if nO < Number(xMin[2])
                    Say(tWhere, tShown, "needs at least " + xMin[2] + " key(s)")
                end
            end
            xProps = ["{", []]
            if JHas(xJS, "properties") xProps = JGet(xJS, "properties") end
            for i = 1 to nO
                tK = xOwn[i]
                tSub = tK
                if tPath != "" tSub = tPath + "." + tK end
                if JHas(xJS, "propertyNames")
                    Check(tK, JGet(xJS, "propertyNames"), tWhere, tSub + " (as a key)")
                end
                if JHas(xProps, tK)
                    Check(JGet(xV, tK), JGet(xProps, tK), tWhere, tSub)
                elseif JHas(xJS, "additionalProperties")
                    Check(JGet(xV, tK), JGet(xJS, "additionalProperties"), tWhere, tSub)
                end
            end
        end
    end
end
# ---------------------------------------------------------------- patterns
#
# The regular expressions schema/ uses: literals, ., \d \w \s and escaped punctuation,
# [classes] with ranges, (groups), and * + ? {n} {n,} {n,m}, with ^ and $. Matching keeps
# the set of reachable positions, so it never backtracks. It reads bytes, which is exact for the
# ASCII patterns the schema writes.

class Pattern
    tPat = ""
    nAt = 1

    def Search(tPattern, tSubject)
        tPat = tPattern
        nAt = 1
        xSeq = ParseSeq()
        if nAt <= Len(tPat) Raise("an unmatched ) at " + String(nAt)) end
        nS = Len(tSubject)
        xStart = []
        for p = 1 to nS + 1
            xStart + p
        end
        xEnd = Run(xSeq, tSubject, xStart)
        return Len(xEnd) > 0
    end
    def ParseSeq
        xSeq = []
        nP = Len(tPat)
        while nAt <= nP
            tC = tPat[nAt]
            if tC = ")" exit end
            if tC = "|" Raise("alternation | is not supported") end
            if tC = "^"
                nAt++
                xSeq + ["bol", "", 1, 1]
                loop
            end
            if tC = "$"
                nAt++
                xSeq + ["eol", "", 1, 1]
                loop
            end
            if tC = "("
                nAt++
                xInner = ParseSeq()
                if nAt > nP or tPat[nAt] != ")" Raise("a ( is never closed") end
                nAt++
                xNode = ["grp", xInner, 1, 1]
            elseif tC = "["
                xNode = ["set", ParseClass(), 1, 1]
            elseif tC = "."
                nAt++
                xNode = ["set", [0, [[0, 9], [11, 255]]], 1, 1]     # any byte but a line feed
            elseif tC = "\"
                nAt++
                xNode = ["set", EscapeSet(), 1, 1]
            else
                nAt++
                nB = Ascii(tC)
                xNode = ["set", [0, [[nB, nB]]], 1, 1]
            end
            xQ = ParseQuantifier()
            xNode[3] = xQ[1]
            xNode[4] = xQ[2]
            xSeq + xNode
        end
        return xSeq
    end
    # After a backslash: a class letter or a literal character. Returns [negate, ranges].
    def EscapeSet
        if nAt > Len(tPat) Raise("the pattern ends on a backslash") end
        tE = tPat[nAt]
        nAt++
        if tE = "d" return [0, [[48, 57]]] end
        if tE = "w" return [0, [[48, 57], [65, 90], [97, 122], [95, 95]]] end
        if tE = "s" return [0, [[9, 10], [13, 13], [32, 32]]] end
        nB = Ascii(tE)
        return [0, [[nB, nB]]]
    end
    def ParseClass
        nAt++
        nNeg = 0
        xR = []
        nP = Len(tPat)
        if nAt <= nP and tPat[nAt] = "^"
            nNeg = 1
            nAt++
        end
        bFirst = true
        while true
            if nAt > nP Raise("a [ is never closed") end
            tC = tPat[nAt]
            if tC = "]" and not bFirst
                nAt++
                exit
            end
            bFirst = false
            if tC = "\"
                nAt++
                xE = EscapeSet()
                nE = Len(xE[2])
                for i = 1 to nE
                    xR + xE[2][i]
                end
                loop
            end
            nLo = Ascii(tC)
            nAt++
            if nAt + 1 <= nP and tPat[nAt] = "-" and tPat[nAt + 1] != "]"
                nHi = Ascii(tPat[nAt + 1])
                nAt += 2
                xR + [nLo, nHi]
            else
                xR + [nLo, nLo]
            end
        end
        return [nNeg, xR]
    end
    def ParseQuantifier
        nP = Len(tPat)
        if nAt > nP return [1, 1] end
        tC = tPat[nAt]
        if tC = "*"
            nAt++
            return [0, -1]
        end
        if tC = "+"
            nAt++
            return [1, -1]
        end
        if tC = "?"
            nAt++
            return [0, 1]
        end
        if tC != "{" return [1, 1] end
        nClose = 0
        for i = nAt to nP
            if tPat[i] = "}"
                nClose = i
                exit
            end
        end
        if nClose = 0 Raise("a { is never closed") end
        tIn = SubStr(tPat, nAt + 1, nClose - nAt - 1)
        nAt = nClose + 1
        nComma = SubStr(tIn, ",")
        if nComma = 0
            if not IsDigits(tIn) Raise("{" + tIn + "} is not a count") end
            return [Number(tIn), Number(tIn)]
        end
        tLo = Left(tIn, nComma - 1)
        tHi = SubStr(tIn, nComma + 1, Len(tIn) - nComma)
        if not IsDigits(tLo) Raise("{" + tIn + "} is not a count") end
        if tHi = "" return [Number(tLo), -1] end
        if not IsDigits(tHi) Raise("{" + tIn + "} is not a count") end
        return [Number(tLo), Number(tHi)]
    end
    # Every position reachable after matching the sequence from any of the given positions.
    def Run(xSeq, tS, xPos)
        nN = Len(xSeq)
        for i = 1 to nN
            xPos = Repeat(xSeq[i], tS, xPos)
            if Len(xPos) = 0 return [] end
        end
        return xPos
    end
    def Repeat(xNode, tS, xPos)
        nMin = xNode[3]
        nMax = xNode[4]
        xOut = []
        if nMin = 0 xOut = xPos end
        xCur = xPos
        nGuard = Len(tS) + 2
        nK = 0
        while true
            nK++
            xCur = StepOnce(xNode, tS, xCur)
            if Len(xCur) = 0 exit end
            if nK >= nMin xOut = Union(xOut, xCur) end
            if nMax != -1 and nK >= nMax exit end
            if nK > nGuard and nK > nMin exit end
        end
        return xOut
    end
    def StepOnce(xNode, tS, xPos)
        tKind = xNode[1]
        nS = Len(tS)
        xOut = []
        nN = Len(xPos)
        if tKind = "grp" return Run(xNode[2], tS, xPos) end
        for i = 1 to nN
            xP = xPos[i]
            if tKind = "bol"
                if xP = 1 xOut + xP end
            elseif tKind = "eol"
                if xP = nS + 1 xOut + xP end
            else
                if xP <= nS and InSet(xNode[2], Ascii(tS[xP])) xOut + (xP + 1) end
            end
        end
        return xOut
    end
    def InSet(xSet, xB)
        xR = xSet[2]
        nN = Len(xR)
        bIn = false
        for i = 1 to nN
            if xB >= xR[i][1] and xB <= xR[i][2]
                bIn = true
                exit
            end
        end
        if xSet[1] = 1 return not bIn end
        return bIn
    end
    def Union(xA, xB)
        xOut = xA
        nN = Len(xB)
        for i = 1 to nN
            if Find(xOut, xB[i]) = 0 xOut + xB[i] end
        end
        return xOut
    end
end
# ---------------------------------------------------------------- the YAML reader
#
# radar.yaml is read with a small, strict subset of YAML, enough for a configuration a person
# writes by hand (docs/ADOPT.md, "The file"):
#   key: value              a map; keys are letters, digits, _ and -
#   key:                    a deeper block follows, indented by spaces (a tab is refused)
#   - value / - key: value  a list of values, or of maps
#   "text", 'text', text    a string; true, false and null are themselves; # starts a comment
#   [a, b, "c d"]           a short list on one line
#   key: |  or  key: >      a block of text on the lines below (| keeps the line breaks, > joins them)
# Anything else is refused with its line number, never guessed. The result has the JSON reader's
# shape, so every check that reads JSON reads this too.
class YamlReader
    xSrc = []
    nAt = 1
    tDoc = ""

    def Parse(tText, tWhere)
        tDoc = tWhere
        xSrc = YamlLines(StripCR(tText))
        nAt = 1
        SkipEmpty()
        if nAt > Len(xSrc) return ["{", []] end
        xV = Block(Indent(xSrc[nAt]))
        SkipEmpty()
        if nAt <= Len(xSrc) Fail("this line is indented less than its block and more than its parent") end
        return xV
    end
    def Fail(tMsg)
        Raise(tDoc + ", line " + String(nAt) + ": " + tMsg)
    end
    def Indent(tL)
        nN = 0
        nL = Len(tL)
        while nN < nL and tL[nN + 1] = " " nN++ end
        if nN < nL and Ascii(tL[nN + 1]) = 9 Fail("a tab indents this line; indent with spaces") end
        return nN
    end
    def IsEmpty(tL)
        xC = Uncomment(tL)
        return Trim(xC) = ""
    end
    def SkipEmpty
        while nAt <= Len(xSrc) and IsEmpty(xSrc[nAt]) nAt++ end
    end
    # The text of a line with its comment removed: # starts a comment at the line's start or after a
    # space, outside quotes.
    def Uncomment(tL)
        tQ = ""
        nL = Len(tL)
        for i = 1 to nL
            tC = tL[i]
            if tQ != ""
                if tC = tQ tQ = "" end
            elseif tC = '"' or tC = "'"
                tQ = tC
            elseif tC = "#" and (i = 1 or tL[i - 1] = " ")
                return Left(tL, i - 1)
            end
        end
        return tL
    end
    # A block: every line at this indent is one key of a map, or one item of a list.
    def Block(nInd)
        tFirst = Trim(Uncomment(xSrc[nAt]))
        if tFirst = "-" or Left(tFirst, 2) = "- " return Seq(nInd) end
        return Mapping(nInd)
    end
    def Mapping(nInd)
        xPairs = []
        xKeys = []
        while true
            SkipEmpty()
            if nAt > Len(xSrc) exit end
            xN = Indent(xSrc[nAt])
            if xN < nInd exit end
            if xN > nInd Fail("this line is indented more than the keys above it") end
            tL = Trim(Uncomment(xSrc[nAt]))
            if Left(tL, 2) = "- " or tL = "-" Fail("a list item where a key of the map is expected") end
            xKV = SplitKey(tL)
            tK = xKV[1]
            if Find(xKeys, tK) > 0 Fail("the key " + tK + " is written twice") end
            xKeys + tK
            xPairs + [tK, Value(xKV[2], nInd)]
        end
        return ["{", xPairs]
    end
    def Seq(nInd)
        xItems = []
        while true
            SkipEmpty()
            if nAt > Len(xSrc) exit end
            xN = Indent(xSrc[nAt])
            if xN < nInd exit end
            if xN > nInd Fail("this line is indented more than the list items above it") end
            tL = Trim(Uncomment(xSrc[nAt]))
            if not (Left(tL, 2) = "- " or tL = "-") Fail("a key where a list item is expected") end
            tRest = Trim(SubStr(tL, 2, Len(tL)))
            if tRest = ""
                nAt++
                SkipEmpty()
                if nAt > Len(xSrc) or Indent(xSrc[nAt]) <= nInd Fail("an empty list item") end
                xItems + Block(Indent(xSrc[nAt]))
            elseif IsKeyLine(tRest)
                # "- key: value": a map whose keys sit where the text after "- " starts
                nKeyInd = nInd + 2
                xSrc[nAt] = Copy(" ", nKeyInd) + tRest
                xItems + Mapping(nKeyInd)
            else
                xItems + Scalar(tRest)
                nAt++
            end
        end
        return ["[", xItems]
    end
    def IsKeyLine(tL)
        if Left(tL, 1) = '"' or Left(tL, 1) = "'" or Left(tL, 1) = "[" return false end
        nC = SubStr(tL, ":")
        if nC < 2 return false end
        if nC < Len(tL) and tL[nC + 1] != " " return false end
        return KeyName(Left(tL, nC - 1))
    end
    def KeyName(tK)
        nK = Len(tK)
        if nK = 0 return false end
        for i = 1 to nK
            tC = tK[i]
            if not (IsAlnum(tC) or tC = "_" or tC = "-") return false end
        end
        return true
    end
    def SplitKey(tL)
        nC = SubStr(tL, ":")
        if nC < 2 Fail("a line of a map is key: value, and this one has no key") end
        tK = Left(tL, nC - 1)
        if not KeyName(tK) Fail("the key " + tK + " uses a character other than letters, digits, _ and -") end
        if nC < Len(tL) and tL[nC + 1] != " " Fail("a key is followed by a colon and a space") end
        return [tK, Trim(SubStr(tL, nC + 1, Len(tL)))]
    end
    # The value after "key:", which may be on the following lines.
    def Value(tRest, nInd)
        if tRest = "|" or tRest = ">"
            nAt++
            return TextBlock(nInd, tRest = ">")
        end
        nAt++
        if tRest != "" return Scalar(tRest) end
        SkipEmpty()
        if nAt > Len(xSrc) return ["n"] end
        xN = Indent(xSrc[nAt])
        if xN <= nInd
            # a list may sit at the key's own indent
            tL = Trim(Uncomment(xSrc[nAt]))
            if xN = nInd and (Left(tL, 2) = "- " or tL = "-") return Seq(nInd) end
            return ["n"]
        end
        return Block(xN)
    end
    def TextBlock(nInd, bFold)
        xOut = []
        nBody = -1
        while nAt <= Len(xSrc)
            tL = xSrc[nAt]
            if Trim(tL) = ""
                xOut + ""
                nAt++
                loop
            end
            xN = Indent(tL)
            if xN <= nInd exit end
            if nBody < 0 nBody = xN end
            if xN < nBody Fail("a line of this text block is indented less than its first line") end
            xOut + SubStr(tL, nBody + 1, Len(tL))
            nAt++
        end
        while Len(xOut) > 0 and xOut[Len(xOut)] = "" Del(xOut, Len(xOut)) end
        tText = ""
        nO = Len(xOut)
        for i = 1 to nO
            if i > 1
                if bFold and xOut[i] != "" and xOut[i - 1] != ""
                    tText += " "
                else
                    tText += Char(10)
                end
            end
            tText += xOut[i]
        end
        return tText
    end
    def Scalar(tS)
        tS = Trim(tS)
        if Left(tS, 1) = "[" return FlowList(tS) end
        if Left(tS, 1) = '"' or Left(tS, 1) = "'"
            xQ = Quoted(tS, 1)
            if Trim(SubStr(tS, xQ[2], Len(tS))) != "" Fail("text follows the closing quote") end
            return xQ[1]
        end
        if tS = "true" return ["t"] end
        if tS = "false" return ["f"] end
        if tS = "null" or tS = "~" return ["n"] end
        if Left(tS, 1) = "{" or Left(tS, 1) = "&" or Left(tS, 1) = "*" or Left(tS, 1) = "!" or Left(tS, 1) = "|" or Left(tS, 1) = ">"
            Fail("this file uses a YAML feature Radar does not read here (" + Left(tS, 1) + "); write the value in quotes")
        end
        return tS
    end
    # A quoted string starting at nFrom; returns [text, the position after the closing quote].
    def Quoted(tS, nFrom)
        tQ = tS[nFrom]
        tOut = ""
        nI = nFrom + 1
        nS = Len(tS)
        while nI <= nS
            tC = tS[nI]
            if tC = tQ
                if tQ = "'" and nI < nS and tS[nI + 1] = "'"
                    tOut += "'"
                    nI += 2
                    loop
                end
                return [tOut, nI + 1]
            end
            if tQ = '"' and tC = "\" and nI < nS
                tD = tS[nI + 1]
                if tD = "n" tOut += Char(10)
                elseif tD = "t" tOut += Char(9)
                elseif tD = '"' or tD = "\" or tD = "/" tOut += tD
                else Fail("an escape this reader does not know: \" + tD) end
                nI += 2
                loop
            end
            tOut += tC
            nI++
        end
        Fail("a quoted string is not closed on its line")
    end
    def FlowList(tS)
        if Right(tS, 1) != "]" Fail("a [ list is closed with ] on the same line") end
        tIn = Trim(SubStr(tS, 2, Len(tS) - 2))
        xItems = []
        if tIn = "" return ["[", xItems] end
        nI = 1
        nS = Len(tIn)
        while nI <= nS
            while nI <= nS and tIn[nI] = " " nI++ end
            if tIn[nI] = '"' or tIn[nI] = "'"
                xQ = Quoted(tIn, nI)
                xItems + xQ[1]
                nI = xQ[2]
                while nI <= nS and tIn[nI] = " " nI++ end
                if nI <= nS and tIn[nI] != "," Fail("items of a [ list are separated by commas") end
                nI++
            else
                nComma = nI
                while nComma <= nS and tIn[nComma] != "," nComma++ end
                tItem = Trim(SubStr(tIn, nI, nComma - nI))
                if tItem = "" Fail("an empty item in a [ list") end
                xItems + Scalar(tItem)
                nI = nComma + 1
            end
        end
        return ["[", xItems]
    end
# The lines of a text, split on line feeds.
def YamlLines(tText)
    xOut = []
    tCur = ""
    nT = Len(tText)
    for i = 1 to nT
        tC = tText[i]
        if Ascii(tC) = 10
            xOut + tCur
            tCur = ""
        else
            tCur += tC
        end
    end
    if tCur != "" xOut + tCur end
    return xOut
end
end
