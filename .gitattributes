* text=auto eol=lf

# Signed files: their bytes must never be changed by a checkout (docs/FEED.md, "The signature").
feed/*.json -text
feed/*.sig -text
keys/* -text

# A pinned bar version: browsers check its sha384 (docs/BAR.md), so its bytes never change.
bar/lookout-bar-*.js -text
# signatures are data, not code (GitHub read them as Standard ML)
*.sig linguist-detectable=false
bar/radar-bar-*.js -text
